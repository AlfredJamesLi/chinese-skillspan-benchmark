{"id": "845-s0001", "text": " 3、 根据产品需求和产品设计, 编写功能测试设计和用例, 开发自动化测试脚本；", "label": [], "labels": [], "meta": {"id": "845-s0001", "global_id": "845", "source_domain": "应届生招聘", "title": "高级测试工程师(服务器端)(京东JD)", "repartition_split": "test", "empty_hint": "", "track": "iaa_dual_blind_100", "prelabel": "none_dual_blind", "do_not_train": true, "do_not_overwrite_gold_v2": true}}
